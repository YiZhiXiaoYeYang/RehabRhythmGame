# This .gitignore is tuned for Unity projects.

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Visual Studio / Rider / VS Code generated files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Unity crash reports
sysinfo.txt

# Builds and archives
*.apk
*.aab
*.unitypackage
*.app

# Keep required Unity project files tracked
!Assets/**/*.meta
!Packages/manifest.json
!Packages/packages-lock.json
!ProjectSettings/**/*.asset
!Assets/StreamingAssets/Beatmap_FishStep.json
